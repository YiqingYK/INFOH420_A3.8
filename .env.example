# Absolute host path to your locally synced ResearchLibrary folder.
RESEARCH_LIBRARY_DIR=""

# Container path under the bind-mounted local data/ directory.
PAPERS_DB_PATH=/opt/airflow/data/papers.db

# Host port for the local Airflow UI.
AIRFLOW_PORT=8080

# Discord Webhook API 
DISCORD_WEBHOOK_API=""
# Provider: ollama or openai_compatible (for an OpenAI-compatible local server).
LOCAL_LLM_PROVIDER=ollama
# Compose starts only the matching provider profile.
COMPOSE_PROFILES=${LOCAL_LLM_PROVIDER:-ollama}
# Full endpoint URL; for OpenAI-compatible servers, use /v1/chat/completions.
LOCAL_LLM_API=http://ollama:11434/api/generate
# Optional API key for OpenAI-compatible servers (leave empty if not required).
LOCAL_LLM_API_KEY=
# Model name expected by the selected server.
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_MAX_CHARS=24000
