# Absolute host path to your locally synced ResearchLibrary folder.
RESEARCH_LIBRARY_DIR=""

# Container path under the bind-mounted local data/ directory.
PAPERS_DB_PATH=/opt/airflow/data/papers.db

# Host port for the local Airflow UI.
AIRFLOW_PORT=8080

# Discord Webhook API 
DISCORD_WEBHOOK_API=""
# Ollama model downloaded into a persistent Docker volume on first startup.
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_MAX_CHARS=24000
